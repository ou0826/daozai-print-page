+    let frame=||crate::bambu::Doc{
+        printer:crate::bambu::Printer{name:"Good Mini".into(),model:"A1 mini".into()},
+        status:crate::bambu::Status{online:true,gcode:"RUNNING".into(),state_text:String::new(),stage_text:"热床预热".into(),
+            percent:37.0,remaining:Some(42.0),layer:Some(118.0),total_layer:Some(320.0),
+            file:"benchy.3mf".into(),nozzle:Some(214.5),nozzle_target:Some(215.0),
+            bed:Some(59.8),bed_target:Some(60.0),hms:0,print_error:0.0,ams_text:"空闲".into()},
+        age:0.4,
